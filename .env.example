# ---------------------------------------------------------------------------
# code-aisle-demo — DEMO-ONLY environment.
# Copy this file to `.env` and fill in your throwaway Atlas cluster values.
# Do NOT put real production secrets or internal company URLs in here.
# ---------------------------------------------------------------------------

# Connection string for a THROWAWAY MongoDB Atlas cluster used only for this demo.
#
# TWO-CLUSTER STRATEGY (develop free, rerank paid):
#   • FREE cluster (M0): ingestion, Automated Embeddings, voyage-code-4, Vector
#     Search, and the code-aware agent all work here. Develop + rehearse on this.
#   • 8.3+ cluster: the SAME app, just point MONGODB_URI here to unlock the
#     native $rerank beat (requires MongoDB 8.3+ AND Native Reranking enabled in
#     Project Settings). No code change — only this URI changes.
#
# The app auto-detects: if $rerank isn't allowed, it falls back to $vectorSearch
# ranking and reports `reranked: false`. Confirmed empirically: a free M0 on
# MongoDB 8.0.32 returns AtlasError "$rerank is not allowed".
#
# Example: mongodb+srv://demo-user:demo-pass@demo-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<demo-user>:<demo-pass>@<demo-cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database + collection used for the demo corpus.
MONGODB_DB="code_aisle_demo"
MONGODB_COLLECTION="code_chunks"

# Vector Search index name (autoEmbed index created in scripts/create-index.mjs).
VECTOR_INDEX_NAME="code_auto_index"

# Voyage AI embedding model used by Automated Embedding.
# voyage-code-4 is code-optimized and REQUIRES an Atlas deployment.
EMBED_MODEL="voyage-code-4"

# Voyage AI reranker model for the $rerank stage (native reranking).
# rerank-2.5 = quality; rerank-2.5-lite = latency.
RERANK_MODEL="rerank-2.5"
